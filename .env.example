# Copie para `.env`. O `npm run setup` preenche o bloco "Credenciais" sozinho.

PORT=3100
HOST=127.0.0.1

# Gateway visto do Windows.
GATEWAY_URL=http://127.0.0.1:8090
# Como o container do gateway enxerga este chat.
CHAT_PUBLIC_URL=http://host.docker.internal:3100

# Cadastro de teste no gateway.
CONSUMER_SLUG=chatteste
TENANT_REF=chat
CEDENTE_REF=chat

# Instância da Evolution usada no teste. EVOLUTION_INTERNAL_URL e GATEWAY_INTERNAL_URL são os endereços
# dentro da rede do compose; EVOLUTION_URL é o endereço visto do Windows.
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_INTERNAL_URL=http://evolution-api:8080
GATEWAY_INTERNAL_URL=http://gateway:8090
EVOLUTION_INSTANCE=auvix_teste
EVOLUTION_SERVER_NAME=local-chat

# ── Credenciais (geradas pelo setup; nunca vão para o navegador) ────────────
GATEWAY_BEARER=
GATEWAY_WEBHOOK_SECRET=
EVOLUTION_SERVER_ID=
EVOLUTION_WEBHOOK_PATH=
